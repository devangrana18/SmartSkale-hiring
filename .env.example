# ==============================================================================
# SmartSkale Hiring & Employee Document Management System - Environment Config
# ==============================================================================

# Application Settings
PROJECT_NAME="SmartSkale Hiring & Employee Document Management System"
VERSION="1.0.0"

# Backend Server
PORT=8000
HOST="0.0.0.0"

# Security & JWT Authentication
# Replace with a strong random secret in production (e.g. openssl rand -hex 32)
SECRET_KEY="smartskale_super_secret_jwt_key_2026_production_grade"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# SQLite default for immediate out-of-the-box local development:
DATABASE_URL="sqlite:///./smartskale.db"
# For PostgreSQL (Production):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/smartskale_db"

# Google Cloud & Spreadsheet Integration
# Google Drive Spreadsheet File ID (from the Google Sheets URL)
GOOGLE_DRIVE_FILE_ID="1AijMSTNVYSn4XpJ8kVj2sqAi-oEIBBzY"
GOOGLE_SHEET_NAME="Form Responses 1"

# Official Google Service Account (Optional - for private enterprise sheets):
# Provide file path to credentials.json OR direct JSON string:
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Google OAuth2 Credentials (Optional):
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/google/callback"

# Frontend Origin URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Email Configuration
# ------------------------------------------------------------------------------
# Option A: Resend API (RECOMMENDED for Render / Cloud deployments - No port blocking)
# 1. Sign up for free at https://resend.com (3,000 free emails/month)
# 2. Create an API key and paste below:
RESEND_API_KEY=""

# Option B: Gmail / Standard SMTP
# NOTE: Free cloud tiers (like Render free) block outbound SMTP ports (25, 465, 587).
# If using SMTP, use a 16-character Google App Password (not your normal password):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="SmartSkale HR"
